# Datos del proyecto de Supabase (Project Settings > API). La clave "publishable" es pública.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxx

# Opcional: captcha en la pantalla de acceso (Cloudflare Turnstile). Es la "Site Key", que es pública.
# Sin esta variable la app anda igual, sin captcha. Los pasos están en el README ("Captcha").
VITE_TURNSTILE_SITEKEY=
